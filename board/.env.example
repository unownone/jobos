# Copy to board/.env locally. bash board/start.sh / scripts/hub_deploy.sh mints empty tokens.
# Never commit real tokens. Maintainer issues each bot its role token out of band.

BOARD_HOST=0.0.0.0
BOARD_PORT=8787
BOARD_DB=data/board.db
# Bare metal: uncomment and point at a Postgres this process can reach.
# Compose in this directory interpolates this file. Leave DATABASE_URL unset
# so a copied example does not send Hub to 127.0.0.1 instead of the bundled
# service. Inside Compose, a host database is host.docker.internal.
# DATABASE_URL=postgresql://jobos:jobos@127.0.0.1:5432/jobos

BOARD_TOKEN_DISCOVERY=
BOARD_TOKEN_APPLY=
BOARD_TOKEN_OUTREACH=
BOARD_TOKEN_ADMIN=
BOARD_TOKEN_MAINTENANCE=

# Public origin for invite / signup / onboarding URLs (no tokens in the origin).
# Full URL, hostname, or IP:port all work: http://hub.example:8787  |  12.234.244.34:343
HUB_PUBLIC_URL=http://127.0.0.1:8787
HUB_PUBLIC_HOST=

# One-time admin bootstrap. Minted on first start as jh_boot_* ; wiped after POST /api/auth/bootstrap.
# After the first admin exists, /admin/signup redirects to /login.
HUB_BOOTSTRAP_TOKEN=

# LEGACY env names (Coolify/host compose). Queue is Postgres; AMQP is unused.
AMQP_URL=
QUEUE_ADAPTER=postgres
BLOB_ROOT=
BLOB_ADAPTER=filesystem

# Unused until connector blobs (Gmail etc). Do not commit the real value.
HUB_DATA_KEY=
