# Copy to board/.env locally, then run scripts/board_gen_tokens.py
# Never commit real tokens. Maintainer issues each bot its role token out of band.

BOARD_HOST=0.0.0.0
BOARD_PORT=8787
BOARD_DB=data/board.db

BOARD_TOKEN_DISCOVERY=
BOARD_TOKEN_APPLY=
BOARD_TOKEN_OUTREACH=
BOARD_TOKEN_ADMIN=
BOARD_TOKEN_MAINTENANCE=

# Public origin for printed signup / invite URLs (no tokens in the origin).
HUB_PUBLIC_URL=http://127.0.0.1:8787

# One-time admin bootstrap. Minted on first start as jh_boot_* ; wiped after POST /api/auth/bootstrap.
HUB_BOOTSTRAP_TOKEN=

# Unused until connector blobs (Gmail etc). Do not commit the real value.
HUB_DATA_KEY=
