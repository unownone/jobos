# Copy to .env locally. Never commit real values.

# Candidate identity (also keep the structured copy in profiles/candidate.yaml)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=

# Research MCPs (pick what you have; deep-research skill degrades gracefully)
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# dzhng/open-deep-research local runner (aliases accepted by scripts/run_deep_research.py)
FIRECRAWL_KEY=
OPENAI_KEY=
OPENAI_API_KEY=
FIREWORKS_KEY=
OPENAI_ENDPOINT=
CUSTOM_MODEL=
FIRECRAWL_BASE_URL=
FIRECRAWL_CONCURRENCY=2
JOBOS_DEEP_RESEARCH_DIR=

# Outreach enrichment (verify before send; do not guess emails)
HUNTER_API_KEY=

# Optional no-key research fallback (Parallel Search MCP)
# Production: Authorization Bearer PARALLEL_API_KEY
PARALLEL_API_KEY=

# Optional if Exa/Tavily/Parallel are all missing
BRAVE_API_KEY=

# Optional overlays (not required; git ledger is source of truth)
GOOGLE_DRIVE_LEDGER_FOLDER_ID=
GMAIL_FROM=

# Live hunt board (maintainer-owned). Tokens are per-role and gitignored.
# Generate with: uv run scripts/board_gen_tokens.py --print
BOARD_URL=http://127.0.0.1:8787
BOARD_ROLE=
BOARD_TOKEN=
