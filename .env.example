# Copy to .env locally. Never commit real values.

# Candidate identity (also keep the structured copy in profiles/candidate.yaml)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=

# Research MCPs (pick what you have; deep-research skill degrades gracefully)
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# dzhng/open-deep-research local runner (aliases accepted by scripts/run_deep_research.py)
FIRECRAWL_KEY=
OPENAI_KEY=
OPENAI_API_KEY=
FIREWORKS_KEY=
OPENAI_ENDPOINT=
CUSTOM_MODEL=
FIRECRAWL_BASE_URL=
FIRECRAWL_CONCURRENCY=2
JOBOS_DEEP_RESEARCH_DIR=

# Outreach enrichment (verify before send; do not guess emails)
HUNTER_API_KEY=

# Optional no-key research fallback (Parallel Search MCP)
# Production: Authorization Bearer PARALLEL_API_KEY
PARALLEL_API_KEY=

# Optional if Exa/Tavily/Parallel are all missing
BRAVE_API_KEY=

# Optional overlays (not required; Hub DB is source of truth)
GOOGLE_DRIVE_LEDGER_FOLDER_ID=
GMAIL_FROM=

# Live Hub (multi-tenant). Sign up with username + password at /login.
# Local secrets are minted into gitignored .hub/ by scripts/hub_deploy.sh.
BOARD_URL=http://127.0.0.1:8787
BOARD_HOST=0.0.0.0
BOARD_PORT=8787
# Leave DATABASE_URL unset for Compose (Hub reaches postgres by service name).
# Bare metal: DATABASE_URL=postgresql://jobos:jobos@127.0.0.1:5432/jobos
# DATABASE_URL=
HUB_PUBLIC_URL=http://127.0.0.1:8787
HUB_PUBLIC_HOST=
HUB_BOOTSTRAP_TOKEN=
BOARD_TOKEN_DISCOVERY=
BOARD_TOKEN_APPLY=
BOARD_TOKEN_OUTREACH=
BOARD_TOKEN_ADMIN=
BOARD_TOKEN_MAINTENANCE=
BOARD_ROLE=
BOARD_TOKEN=

# Queue. Compose defaults to postgres; local tests can use memory.
AMQP_URL=
QUEUE_ADAPTER=memory

# Volumized resume/file store. Filesystem Adapter is the default.
BLOB_ROOT=
BLOB_ADAPTER=filesystem
HUB_DATA_KEY=
