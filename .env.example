# Copy to .env locally. Never commit real values.

# Candidate identity (also keep the structured copy in profiles/candidate.yaml)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=

# Research MCPs (pick what you have; deep-research skill degrades gracefully)
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# dzhng/open-deep-research local runner (npm --prefix agent-tools/open-deep-research run api)
FIRECRAWL_KEY=
OPENAI_KEY=
OPENAI_API_KEY=
FIREWORKS_KEY=
OPENAI_ENDPOINT=
CUSTOM_MODEL=
FIRECRAWL_BASE_URL=
FIRECRAWL_CONCURRENCY=2
JOBOS_DEEP_RESEARCH_DIR=

# Outreach enrichment (verify before send; do not guess emails)
HUNTER_API_KEY=

# Optional no-key research fallback (Parallel Search MCP)
# Production: Authorization Bearer PARALLEL_API_KEY
PARALLEL_API_KEY=

# Optional if Exa/Tavily/Parallel are all missing
BRAVE_API_KEY=

# Optional overlays (not required; Hub DB is source of truth)
GOOGLE_DRIVE_LEDGER_FOLDER_ID=
GMAIL_FROM=

# Live hunt board (multi-tenant). Sign up with username + password at /login.
# Compat role tokens are optional (X-Role tests / legacy agents).
BOARD_URL=http://127.0.0.1:8787
BOARD_ROLE=
BOARD_TOKEN=

# Production queue (RabbitMQ). Tests leave this empty and use the memory Adapter.
AMQP_URL=
QUEUE_ADAPTER=memory

# Resume / candidate YAML object store.
# Prefer S3 (MinIO / R2 / AWS): set BLOB_DRIVER=s3 and the S3_* vars, or run
# `docker compose --profile blobs` so HUB_PLUGINS=auto points at MinIO.
# Filesystem remains the offline Coolify default via BLOB_ADAPTER.
BLOB_ROOT=
BLOB_ADAPTER=filesystem
BLOB_DRIVER=
S3_ENDPOINT=
S3_BUCKET=jobos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
