# job-scout-mcp works with ZERO configuration using keyless public sources
# (Greenhouse, Lever, Ashby, Hacker News, RemoteOK).
#
# The variables below are all OPTIONAL. Set them to enable extra sources.

# --- Adzuna (optional) -------------------------------------------------------
# Free key: https://developer.adzuna.com/  (adds salary_context + broad search)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Default country code for Adzuna queries (gb, us, au, etc.)
ADZUNA_COUNTRY=gb

# --- USAJobs (optional) ------------------------------------------------------
# Free key: https://developer.usajobs.gov/  (US federal roles)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Tracked ATS companies (optional) ----------------------------------------
# Comma-separated "provider:slug" pairs used as defaults by list_company_jobs
# and the multi-source search. Find the slug in a company's careers URL, e.g.
# boards.greenhouse.io/stripe -> greenhouse:stripe
# jobs.lever.co/netflix       -> lever:netflix
# jobs.ashbyhq.com/notion     -> ashby:notion
TRACKED_COMPANIES=greenhouse:stripe,lever:netflix,ashby:notion

# --- Behaviour ---------------------------------------------------------------
# HTTP cache TTL in seconds (be polite to public endpoints)
CACHE_TTL_SECONDS=900
# Contact string sent in the User-Agent header
CONTACT=job-scout-mcp (https://github.com/pabnatanawan87/job-scout-mcp)
