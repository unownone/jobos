{
  "name": "job-scout-mcp",
  "version": "0.1.0",
  "description": "A Model Context Protocol server that scouts job openings from public, ToS-clean sources (Greenhouse, Lever, Ashby, Hacker News, RemoteOK) with optional Adzuna/USAJobs support.",
  "type": "module",
  "bin": {
    "job-scout-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "job-search",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
