{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobos.local/schema/skill.json",
  "title": "Job Apply OS skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "kind", "role", "tags", "body"],
  "properties": {
    "id": { "type": "string", "pattern": "^(skl_|compat:).+" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$",
      "description": "Stable id among shared skills. Local skills are unique per owner."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "type": "string", "enum": ["skill", "mcp", "http", "builtin"] },
    "role": {
      "type": "string",
      "enum": ["discovery", "apply", "outreach", "research", "maintain", "agent"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
        "description": "Motion tags are source|apply|outreach|research|maintain. Add platform/ATS tags as needed (workday, indeed, greenhouse)."
      }
    },
    "scope": { "type": "string", "enum": ["shared", "local"] },
    "owner_user_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["draft", "recorded", "proctoring", "approved", "rejected", "retired"]
    },
    "platform": { "type": "string" },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ats": { "type": "array", "items": { "type": "string" } },
        "url_patterns": { "type": "array", "items": { "type": "string" } },
        "apply_kind": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reproducible": { "type": "boolean" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "body": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "string",
      "enum": ["github", "recording", "mutation", "memory"]
    },
    "origin_ref": { "type": "string" },
    "parent_skill_id": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 },
    "content_hash": { "type": "string" },
    "proctor_status": {
      "type": "string",
      "enum": ["none", "pending", "passed", "failed"]
    },
    "proctor_note": { "type": "string" },
    "proctor_evidence": { "type": "object" }
  }
}
